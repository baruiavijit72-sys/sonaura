<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sonaura.app">
    <application
        android:label="Sonaura"
        android:name="${\applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|modement|lucale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true">
            <meta-data
                android:name="io.flutter.embedding.android.NotificationChannelId"
                android:value="sonaura_channel" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAENCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEditing
            android:value="v2" />
    </application>
</manifest>